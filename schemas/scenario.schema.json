{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/galafis/go2-pro-link-resilience/blob/main/schemas/scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "source", "ttlScale", "messages", "windows"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "source": {
      "enum": ["synthetic", "manual"]
    },
    "ttlScale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "createdMs", "sizeBytes", "ttlMs", "priority"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "createdMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400000
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "ttlMs": {
            "type": "number",
            "minimum": 1,
            "maximum": 3600000
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startMs", "endMs", "kbps", "latencyMs"],
        "properties": {
          "startMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400000
          },
          "endMs": {
            "type": "number",
            "minimum": 1,
            "maximum": 100000000
          },
          "kbps": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600000
          }
        }
      },
      "minItems": 0,
      "maxItems": 100
    }
  }
}
